              "value": "0"
            }
          ]
        },
        "options": {},
        "authentication": "genericCredentialType",
        "genericAuthType": "httpCustomAuth"
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 4000,
      "credentials": {
        "httpCustomAuth": {
          "id": "dK4fq0NoveYWlOww",
          "name": "Deconetwork log in"
        }
