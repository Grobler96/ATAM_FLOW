    {
      "id": "a0910a0e-55de-43ed-9180-73a191cd14a3",
      "name": "Build priority flags",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        672,
        0
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const flags = [];\nconst seen = new Set();\nlet total = 0;\nfor (const it of items) {\n  let p = it.json;\n  if (typeof p.data === 'string') { try { p = JSON.parse(p.data); } catch (e) { continue; } }\n  if (Number(p.total) > total) total = Number(p.total);\n  for (const o of (p.orders || [])) {\n    const id = String(o.order_id);\n    if (seen.has(id)) continue;\n    seen.add(id);\n    flags.push({ order_id: id, is_priority: o.is_priority === true });\n  }\n}\nif (total > flags.length) throw new Error('Read ' + flags.length + ' of ' + total + ' orders: raise the number of pages so no priority flag is missed.');\nreturn [{ json: { p_flags: flags, p_triggered_by: 'schedule' } }];\n"
      }
    },
