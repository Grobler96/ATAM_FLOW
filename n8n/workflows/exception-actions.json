      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const req = $('Dashboard: exception action').first().json.body || {};\nconst p = req.params || {};\nconst caller = $('Verify caller').first().json;\nconst actor = 'dashboard:' + caller.userId;\nconst senior = ['admin', 'manager'].includes(caller.role);\nconst map = {\n  assign:     { rpc: 'flow_assign_exception',               body: { p_id: p.exception_id, p_owner: p.owner, p_actor: actor, p_note: p.note || null } },\n  status:     { rpc: 'flow_set_exception_status',           body: { p_id: p.exception_id, p_status: p.status, p_actor: actor, p_note: p.note || null } },\n  note:       { rpc: 'flow_add_exception_note',             body: { p_id: p.exception_id, p_actor: actor, p_note: p.note, p_is_action: !!p.is_action } },\n  resolve:    { rpc: 'flow_resolve_exception',              body: { p_id: p.exception_id, p_method: p.method, p_note: p.note, p_actor: actor } },\n  link_comm:  { rpc: 'flow_link_exception_communication',   body: { p_id: p.exception_id, p_comm: p.communication_id, p_actor: actor } },\n  raise:      { rpc: 'flow_raise_manual_exception',         body: { p_category: p.category || 'other', p_severity: p.severity, p_description: p.description, p_links: p.links || [], p_owner: p.owner || null, p_deadline: p.deadline || null, p_actor: actor, p_blocks: p.blocks || [] } },\n  write_off:  { rpc: 'flow_write_off_exception',            body: { p_id: p.exception_id, p_reason: p.reason, p_financial_impact: p.financial_impact, p_actor: actor }, seniorOnly: true },\n  cancel:     { rpc: 'flow_cancel_exception',               body: { p_id: p.exception_id, p_reason: p.reason, p_actor: actor }, seniorOnly: true },\n  reopen:     { rpc: 'flow_reopen_exception',               body: { p_id: p.exception_id, p_actor: actor, p_reason: p.reason }, seniorOnly: true }\n};\nconst m = map[req.action];\nif (!m) return [{ json: { valid: false, code: 400, error: 'Unknown action. Allowed: ' + Object.keys(map).join(', ') } }];\nif (m.seniorOnly && !senior) return [{ json: { valid: false, code: 403, error: 'Only a manager or admin can ' + req.action.replace('_', ' ') + ' an exception.' } }];\nreturn [{ json: { valid: true, action: req.action, rpc: m.rpc, body: m.body } }];"
      }
    },
