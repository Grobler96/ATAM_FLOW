      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const req = $('Dashboard: artwork action').first().json.body || {};\nconst p = req.params || {};\nconst actor = 'dashboard:' + $('Verify caller').first().json.userId;\nconst map = {\n  import:         { rpc: 'flow_artwork_upsert',         body: { p_items: p.items, p_actor: actor } },\n  validate:       { rpc: 'flow_artwork_validate',       body: { p_order: p.order_id } },\n  manual_replace: { rpc: 'flow_artwork_manual_replace', body: { p_order: p.order_id, p_deco_line_id: p.deco_line_id || null, p_area: p.area, p_storage_path: p.storage_path, p_actor: actor, p_note: p.note, p_meta: p.meta || {} } },\n  set_approval:   { rpc: 'flow_artwork_set_approval',   body: { p_id: p.artwork_id, p_status: p.status, p_actor: actor, p_note: p.note } },\n  build_pack:     { rpc: 'flow_build_job_pack',         body: { p_order: p.order_id, p_producer: p.producer_id, p_actor: actor, p_movement: p.movement_id || null } },\n  mark_pack_sent: { rpc: 'flow_job_pack_mark_sent',     body: { p_pack: p.pack_id, p_actor: actor } }\n};\nconst m = map[req.action];\nif (!m) return [{ json: { valid: false, error: 'Unknown action. Allowed: ' + Object.keys(map).join(', ') } }];\nreturn [{ json: { valid: true, action: req.action, rpc: m.rpc, body: m.body } }];"
      }
    },
