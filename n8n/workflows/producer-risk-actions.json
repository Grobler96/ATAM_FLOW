        672,
        96
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const req = $('Dashboard: producer risk action').first().json.body || {};\nconst p = req.params || {};\nconst who = $('Verify caller').first().json;\nconst role = who.role;\nconst actor = 'dashboard:' + who.userId;\nconst senior = ['admin', 'manager'].includes(role);\nconst floor = ['admin', 'manager', 'warehouse'].includes(role);\nconst bad = (error, code = 400) => [{ json: { valid: false, code, error } }];\nconst ok = (rpc, body, note) => [{ json: { valid: true, rpc, body, note } }];\nconst s = (v) => String(v == null ? '' : v).trim();\nswitch (req.action) {\n  case 'suspend':\n    if (!senior) return bad('Only a manager or admin can suspend a producer.', 403);\n    if (!p.producer_id) return bad('Choose a producer.');\n    return ok('flow_pr_suspend', { p_producer: p.producer_id, p_reason: s(p.reason), p_actor: actor }, 'Producer suspended. No new work can be sent to them.');\n  case 'resume':\n    if (!senior) return bad('Only a manager or admin can let a suspended producer take work again.', 403);\n    if (!p.producer_id) return bad('Choose a producer.');\n    return ok('flow_pr_resume', { p_producer: p.producer_id, p_note: s(p.reason), p_actor: actor }, 'Producer can take work again.');\n  case 'record_contact':\n    if (!p.producer_id) return bad('Choose a producer.');\n    return ok('flow_pr_record_contact', { p_producer: p.producer_id, p_note: s(p.note), p_actor: actor }, 'Contact recorded.');\n  case 'set_limits':\n    if (!senior) return bad('Only a manager or admin can change a producer\\'s limits and contacts.', 403);\n    if (!p.producer_id) return bad('Choose a producer.');\n    return ok('flow_pr_set_limits', { p_producer: p.producer_id, p_emergency_contact: s(p.emergency_contact) || null, p_emergency_phone: s(p.emergency_phone) || null, p_backup_codes: Array.isArray(p.backup_codes) ? p.backup_codes.map(s).filter(Boolean) : [], p_max_jobs: s(p.max_jobs) ? Number(p.max_jobs) : null, p_actor: actor }, 'Limits and contacts saved.');\n  case 'job_sheet':\n    if (!floor) return bad('Your role cannot draft job sheets.', 403);\n    if (!s(p.code)) return bad('Choose a consignment.');\n    return ok('flow_mv_job_sheet_draft', { p_movement: s(p.code), p_actor: actor }, 'A job sheet email is waiting in the Emails queue for you to review. Nothing has been sent.');\n  default:\n    return bad('Unknown action.');\n}\n"
      }
    },
