{
  "name": "atam-flow-tutorials",
  "private": true,
  "version": "1.0.0",
  "description": "How-to videos for ATAM_FLOW, built with Remotion. Separate from the dashboard: not part of its tests or the Pages deploy.",
  "scripts": {
    "studio": "remotion studio src/index.ts",
    "capture": "node capture/capture.mjs",
    "render": "node scripts/render.mjs",
    "voice": "cd audio && python3 make_voice.py && python3 make_timing.py && python3 make_audio_tutorial.py",
    "catalogue": "node scripts/make-catalogue.mjs",
    "posters": "node scripts/render.mjs --posters"
  },
  "dependencies": {
    "@fontsource/fredoka": "^5.3.0",
    "@remotion/bundler": "^4.0.250",
    "@remotion/cli": "^4.0.250",
    "@remotion/renderer": "^4.0.250",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "remotion": "^4.0.250"
  },
  "devDependencies": {
    "@types/react": "^18.3.31",
    "typescript": "^5.6.3"
  }
}
